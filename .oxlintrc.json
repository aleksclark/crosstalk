{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/api-client/src/types.ts",
    "server/web/**"
  ]
}
