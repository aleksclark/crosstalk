{
  "name": "@crosstalk/broadcast",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @crosstalk/api-client generate",
    "dev": "vite",
    "prebuild": "pnpm --filter @crosstalk/api-client generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@crosstalk/theme": "workspace:*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vitest": "^3.2.4"
  }
}
