[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=CrossTalk K2B Client (ct-abc / Audio Booth Connector)
After=network-online.target pipewire.service ct-netcfg.service
Wants=network-online.target

[Service]
Type=simple
# Binary is ct-abc (Audio Booth Connector). Historical docs/scripts may still
# say ct-client; the on-device path and this unit use ct-abc.
User=app
Group=audio
SupplementaryGroups=video spi

# Checked helper distinguishes required vs optional failures (see script).
# Leading '+' runs the helper as root before dropping to User=.
ExecStartPre=+/usr/local/lib/crosstalk/ct-app-setup.sh
ExecStart=/usr/local/bin/ct-abc
Environment=CROSSTALK_CONFIG=/etc/app/crosstalk.json
Environment=XDG_RUNTIME_DIR=/run/user/999
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/999
Environment=PULSE_RUNTIME_PATH=/run/user/999/pulse
Environment=USE_DISPLAY=true
# Optional: set to 1 to fail start when SPI display device is missing.
# Environment=CT_APP_REQUIRE_SPI=0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
