FROM golang:1.25-bookworm

WORKDIR /app

RUN mkdir -p /app/bin

# Pure-Go build (PostgreSQL via Bun, no CGO required). Rebuilds on start for
# fast local iteration when the source is bind-mounted.
CMD ["sh", "-c", "cd /app/server && CGO_ENABLED=0 go build -o /app/bin/ct-server ./cmd/ct-server && exec /app/bin/ct-server"]
